<%- include("partials/header.ejs") %>
<section id="experience" class="section experience">
  <h2>Policing Experience</h2>
  <ul class="panel">
    <% 
    if (locals.policingExperience) {
      locals.policingExperience.forEach((job, index) => { 
  %>
    <li class="tile">
      <img class="small-image" src="<%= job.imageUrl %>" />
      <div>
        <h3><%= job.job %></h3>
        <h4><%= job.role %></h4>
      </div>
      <div>
        <p><%= job.company %></p>
        <p class="small-text"><%= job.duration %></p>
      </div>
      <div>
        <button class="accordion-btn" id="accordion-btn-<%= index %>"
                aria-label="Toggle accordion" aria-controls="accordion-content-<%= index %>" aria-expanded="false" type="button">
          <span class="h-bar"></span>
          <span class="v-bar"></span>
        </button>
      </div>
      <div class="accordion-content" id="accordion-content-<%= index %>">
        <p><%= job.description %></p>
        <ul>
          <% 
          if (job.responsibilities) 
          {job.responsibilities.forEach(responsibility => { 
            %>
          <li><%= responsibility %></li>
          <% 
            });
            } 
        %>
        </ul>
      </div>
    </li>
    <%   
    });
  } 
  %>
  </ul>
</section>
<%- include("partials/footer.ejs") %>
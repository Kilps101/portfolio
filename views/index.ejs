<%- include("partials/header.ejs") %>
<section id="main-intro" class="section intro">
  <%- include("partials/components/intro.ejs") %>
</section>

<section id="projects" class="section projects">
  <h2>Projects</h2>
  <ul class="panel">
    <% 
    if (locals.projects) {
      locals.projects.forEach(project => { 
  %>
    <li class="tile">
      <h3><%= project.title %></h3>
      <img src="<%= project.imageUrl %>" />
      <p><%= project.description %></p>
    </li>
    <%   
    });
  } 
  %>
  </ul>
</section>

<section id="experience" class="section experience">
  <h2>Professional Experience</h2>
  <ul class="panel">
    <% 
    if (locals.professionalExperience) {
      locals.professionalExperience.forEach(job => { 
  %>
    <li class="tile">
      <img class="small-image" src="<%= job.imageUrl %>" />
      <div>
        <h3><%= job.job %></h3>
        <h4><%= job.role %></h4>
      </div>
      <div>
        <p><%= job.company %></p>
        <p class="small-text"><%= job.duration %></p>
      </div>
      <p><%= job.description %></p>
      <ul>
        <% 
        if (job.responsibilities) {
          job.responsibilities.forEach(responsibility => { 
        %>
        <li><%= responsibility %></li>
        <%   
        });
      }
      %>
      </ul>
    </li>
    <%   
    });
  } 
  %>
  </ul>
</section>

<section id="education" class="section education">
  <h2>Certification & Education</h2>
</section>

<section id="working-rights" class="section working-rights">
  <h2>Working Rights</h2>
  <ul class="panel">
    <% 
    if (locals.workingRights) {
      locals.workingRights.forEach(right => { 
  %>
    <li class="tile">
      <img class="medium-image" src="<%= right.imageUrl %>" />
      <p><%= right.description %></p>
    </li>
    <%   
    });
  } 
  %>
  </ul>
</section>

<section id="contact" class="section contact">
  <button class="action">Let's work together!</button>
</section>
<%- include("partials/footer.ejs") %>